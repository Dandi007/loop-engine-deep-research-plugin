{
  "name": "loop-engine-deep-research-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/tick-entry.ts",
  "exports": {
    ".": "./src/tick-entry.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke:cas": "vitest run --config vitest.smoke.config.ts",
    "tick": "vite-node src/tick-entry.ts",
    "tick:help": "vite-node src/tick-entry.ts -- --help",
    "tick:selfcheck": "vite-node src/tick-entry.ts -- --selfcheck",
    "deep-research:dry-run": "bash bin/deep-research-loop.sh --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "yaml": "^2.4.0"
  }
}
