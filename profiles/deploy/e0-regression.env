# E0 —— 「真机端到端回归基线」部署 profile（受版本管理；进 git / 可 diff / 可 review）。
# 加载：bin/e0-regression.sh（本包唯一入口；缺省即加载本 profile，亦可 --profile e0-regression）。
# ⛔ 不要直接用 bin/deep-research-loop.sh --profile e0-regression 加载本 profile：
#    E0c1 §1.3 起 profile 不再写死固定 TICK_CHANNEL（三条 research channel 改由入口按 run_id 派生后导出），
#    故 deep-research-loop.sh 会在其 TICK_CHANNEL 缺省检查处响亮失败（exit 3）；只有
#    bin/e0-regression.sh 先派生再导出 TICK_CHANNEL/EVIDENCE_CHANNEL/DOC_CHANNEL 后再调起 loop。
# 加载顺序：显式 env > 本 profile > 内置缺省（与 bin/deep-research-loop.sh 的语义一致）。
#
# ⛔ 本 profile 的一切 channel 都指向 **测试总线**（127.0.0.1:7495，独立 SQLite 与 token，
#    与生产 7490 零共享）。channel 名统一带 `e0` 与 run 语义前缀，且与生产 profile
#    （profiles/deploy/agent-harness.env）的 channel 名集合交集为空。
# ⛔ 本 profile 只出现 token **文件路径**，绝不出现任何 token 值（宪法第五条）。
#
# AGENT_BUS_URL / AGENT_BUS_TOKEN_FILE 由入口 bin/e0-regression.sh 显式导出指向测试实例；
# 本 profile 不写这两个键（避免与入口的生产护栏冲突）。
#
# E0c1 §1.3 —— 每次运行用一块属于该 run 的干净研究板：三条 research channel 名由
#    profile 基名（RESEARCH_PROFILE_BASE）+ 本次 run_id 派生（如
#    research:e0-<run_segment>.{index,evidence,docs}）。本 profile 不再写死固定 channel 名；
#    TICK_CHANNEL / EVIDENCE_CHANNEL / DOC_CHANNEL 由入口按 run_id 派生后导出（覆盖空缺省）。
#    board:agent-runs 是全局的、不随 run 变（入口在预备清单里 _ensure_channel 它）。

# E0c1 §1.3 —— 研究基名：用于派生 per-run research channel（research:<base>-<runSegment>.{...}）。
RESEARCH_PROFILE_BASE=e0
# G4a —— 研究主问题（--question）：显式给出，无缺省。
RESEARCH_QUESTION=e0 regression baseline
# G4c —— 研究 origin（--origin，report 的 origin 字段）：显式给出，无缺省。
RESEARCH_ORIGIN=dr-e0-regression
# 导出落点根（spec §1.3 / E6）：仓外运行时目录，⛔ 不得落进 vault 的 DeepThought/（那是生产成果落点）。
# 与入口的 E0_RECORD_ROOT（缺省 /data/loop-engine/e0-runs）分开，避免导出产物与逐次运行记录相互穿插。
EXPORT_ROOT=/data/loop-engine/e0-export
# A8f —— worker 可读的 repo 根：指向体量小、必然存在的本地仓，使一轮 code-local 收割可在数分钟内结束。
ALLOWED_ROOT=/data/code/self/agent-runtime
# A10c —— 写入预算上限（有限护栏，非无穷）。
MAX_WRITES=96
# G4d —— anchor-check 校验器二进制（绝对路径）：与生产 profile 同路径，显式给出，无缺省。
ANCHOR_CHECK_BIN=/data/code/self/katana/plugins/deep-research/skills/deep-research/loop-orchestration/tools/anchor-check.py

# E0c1 §1.4 —— 空板自播种：种子文本与 sources 均由 profile 声明（⛔ 不写死在脚本里）。
# 种子文本须与 ALLOWED_ROOT 指向的仓相称、能让 code-local worker 真找到东西，
# ⛔ 不得是放之四海皆可的空话。本 clue 指向 agent-runtime 仓内真实存在的 dispatch 代码
# （src/dispatch.ts: dispatch() 在 line 734，spawnAndWait() 在 line 658；均经实测存在）。
SEED_CLUE=In the ALLOWED_ROOT repo (agent-runtime), read src/dispatch.ts and report which exported function performs the route-materialize-then-spawn step (resolving route env secrets before spawning the child), with the exact file path and line range.
# E0c2 §1.3 —— 跨 drain 循环参数（由 profile 声明，⛔ 不写死在脚本里）。
# 退避 ≥ 120 秒（与 dr-worker-code-local ≈ 158 秒相称），次数 ≥ 12，墙钟 ≥ 2400 秒。
DRAIN_BACKOFF_SECONDS=120
DRAIN_MAX_ATTEMPTS=12
DRAIN_WALL_CLOCK_SECONDS=2400

# E0c2 §1.3 —— 单次 drain 摘要抽取用的 loop-engine runtime root（缺省 /data/loop-engine）。
# 与 read-termination.mjs 的 runtimeRoot() 同款解析逻辑。
LOOP_ENGINE_RUNTIME_ROOT=/data/loop-engine
# 本 profile 用 code-local（与 ALLOWED_ROOT 相配）。
SEED_SOURCES=code-local
# E0c3b §1.1 —— triage 触发阈值：回归 profile 只有 1 条种子线索，worker 大约提 1 条新线索，
# 板上 proposed 永远到不了缺省阈值 3 ⇒ 结构死锁。本 profile 显式设为 1 解开死锁。
TRIAGE_THRESHOLD=1
# E0c4 —— 单个 tick 的声明上界（ms）：超过时响亮失败并点名慢在哪一步。⛔ 不写死在源码里。
# 回归基线取 300 秒（5 分钟），远高于正常 tick 耗时（真机秒级），但仍是有限护栏。
TICK_TIMEOUT_MS=300000
# E0c4 —— 回归基线收窄研究范围：降低 maxClues 使板面在 profile 声明的 DRAIN_WALL_CLOCK_SECONDS
# （2400 秒）内真能收敛。⛔ 不缩到秒级而失去回归意义；取 24（明显低于生产 64，但仍覆盖多轮探索）。
MAX_CLUES=24
