# D1 —— 本地 / 冒烟部署配置（受版本管理）。
# 加载：bin/deep-research-loop.sh --profile local（或 DEPLOY_PROFILE=local）。
# 加载顺序：显式 env > 本 profile > 内置缺省。
#
# ⛔ 故意**不含 EVIDENCE_CHANNEL**（spec §1.4 / §2 E5 反例）：
#    真实证据 channel 不随板 channel 推导，本地不预置。部署方须显式提供
#    （显式 env > profile），否则 `--run` 一旦遇到 harvest 决策由下游响亮失败
#    （MissingEvidenceChannelError），绝不静默写进由字符串推导的错 channel。

TICK_CHANNEL=research:v1-deep-research.local.index
ALLOWED_ROOT=/data/code/self/agent-runtime
MAX_WRITES=64
# 导出落点根（spec §1.3 / E6）。
EXPORT_ROOT=/data/vault/DeepThought-local
